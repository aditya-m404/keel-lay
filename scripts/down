#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

target="local"
wipe=0
for arg in "$@"; do
  case "$arg" in
    --wipe) wipe=1 ;;
    local | local-prod | prod) target="$arg" ;;
    *)
      echo "usage: ./scripts/down [local|local-prod|prod] [--wipe]" >&2
      exit 1
      ;;
  esac
done

case "$target" in
  local) compose_file="infra/compose.local.yaml" ;;
  local-prod) compose_file="infra/compose.local-prod.yaml" ;;
  prod) compose_file="infra/compose.prod.yaml" ;;
esac

if [[ "$target" == "local" ]]; then
  for file in generated/studio.pid generated/web.pid generated/api.pid; do
    if [[ -f "$file" ]]; then
      pid="$(cat "$file")"
      kill "$pid" 2>/dev/null || true
      rm -f "$file"
    fi
  done
fi

echo "stopping $target"
if [[ "$wipe" == 1 ]]; then
  if [[ "${KEEL_WIPE:-}" != "yes" ]]; then
    printf "Delete the %s Postgres volume? Type wipe: " "$target"
    read -r answer
    if [[ "$answer" != "wipe" ]]; then
      echo "cancelled"
      exit 1
    fi
  fi
  docker compose -f "$compose_file" down -v
  echo "$target wiped"
else
  docker compose -f "$compose_file" stop
  echo "$target stopped"
fi
