#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ ! -f .env.example ]]; then
  echo "missing .env.example" >&2
  exit 1
fi

if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "created .env from .env.example"
fi

python3 - <<'PY'
from pathlib import Path
import secrets

example = Path(".env.example").read_text().splitlines()
env_path = Path(".env")
lines = env_path.read_text().splitlines()
present = set()
for line in lines:
    stripped = line.strip()
    if not stripped or stripped.startswith("#") or "=" not in stripped:
        continue
    present.add(stripped.split("=", 1)[0])

added = []
for line in example:
    stripped = line.strip()
    if not stripped or stripped.startswith("#") or "=" not in stripped:
        continue
    key = stripped.split("=", 1)[0]
    if key in present:
        continue
    lines.append(line)
    present.add(key)
    added.append(key)

secret_set = False
secret_found = False
out = []
for line in lines:
    if line.startswith("KEEL_SESSION_SECRET="):
        secret_found = True
        if line.split("=", 1)[1].strip() == "":
            line = "KEEL_SESSION_SECRET=" + secrets.token_urlsafe(32)
            secret_set = True
    out.append(line)
if not secret_found:
    out.append("KEEL_SESSION_SECRET=" + secrets.token_urlsafe(32))
    secret_set = True
    added.append("KEEL_SESSION_SECRET")

env_path.write_text("\n".join(out) + "\n")
for key in added:
    print(f"added {key}")
print("KEEL_SESSION_SECRET set" if secret_set else "KEEL_SESSION_SECRET already set")
PY
