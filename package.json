{
  "name": "keel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env:sync": "./scripts/env-sync",
    "dev": "./scripts/up local",
    "dev:local": "./scripts/up local",
    "dev:prod": "./scripts/up local-prod",
    "local-prod": "./scripts/up local-prod",
    "local-prod:rebuild": "KEEL_REBUILD=1 ./scripts/up local-prod",
    "prod": "./scripts/up prod",
    "down": "./scripts/down local",
    "down:local": "./scripts/down local",
    "down:local-prod": "./scripts/down local-prod",
    "down:prod": "./scripts/down prod",
    "down:wipe": "./scripts/down local --wipe",
    "down:wipe:local-prod": "./scripts/down local-prod --wipe",
    "status": "node scripts/status.ts",
    "doctor": "./scripts/doctor",
    "collector:render": "node scripts/render-collector.ts",
    "build": "node scripts/bundle-api.mjs && pnpm --filter @keel/web build && pnpm --filter @keel/studio build && node scripts/bundle-studio.mjs",
    "build:api": "node scripts/bundle-api.mjs",
    "build:web": "pnpm --filter @keel/web build",
    "build:studio": "pnpm --filter @keel/studio build && node scripts/bundle-studio.mjs",
    "prove": "node scripts/prove.ts",
    "journeys:check": "node scripts/journeys-check.ts",
    "check": "node scripts/journeys-check.ts && node --test collector/routing.test.mjs collector/multi.test.mjs && pnpm exec tsc -p apps/api --noEmit && pnpm exec tsc -p apps/web --noEmit && pnpm exec tsc -p apps/studio --noEmit",
    "phase": "node scripts/phase.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
